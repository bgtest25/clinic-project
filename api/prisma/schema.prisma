// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLINICIAN
}

enum EncounterStatus {
  RECORDING
  TRANSCRIBING
  DRAFTING
  IN_REVIEW
  SIGNED
  FAILED
}

enum NoteStatus {
  DRAFT
  SIGNED
  AMENDED
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  patients Patient[]

  @@map("clinics")
}

model User {
  id         String   @id @default(uuid())
  cognitoSub String   @unique
  email      String   @unique
  name       String
  role       UserRole @default(CLINICIAN)
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Offboarding: null while active. The row itself is never deleted — that
  // would orphan ClinicalNote.signedById / AuditLog.actorId and corrupt the
  // legal/audit record — so deactivation is a flag, not a removal.
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])

  encounters           Encounter[]          @relation("ClinicianEncounters")
  signedNotes          ClinicalNote[]       @relation("SignedByUser")
  auditEntries         AuditLog[]           @relation("AuditLogActor")
  targetedAuditEntries AuditLog[]           @relation("AuditLogTargetUser")
  deactivatedUsers     User[]               @relation("UserDeactivatedBy")
  loggedDataRequests   PatientDataRequest[] @relation("PatientDataRequestLoggedBy")
  resolvedDataRequests PatientDataRequest[] @relation("PatientDataRequestResolvedBy")

  @@index([clinicId])
  @@index([deactivatedById])
  @@map("users")
}

model Patient {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  dateOfBirth DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  encounters   Encounter[]
  auditLogs    AuditLog[]
  dataRequests PatientDataRequest[]

  @@index([clinicId])
  @@map("patients")
}

model Encounter {
  id                String          @id @default(uuid())
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id])
  clinicianId       String
  clinician         User            @relation("ClinicianEncounters", fields: [clinicianId], references: [id])
  visitDate         DateTime        @default(now())
  status            EncounterStatus @default(RECORDING)
  consentCapturedAt DateTime?
  consentCapturedBy String?
  // Set only when status = FAILED, so staff know why without digging into
  // CloudWatch/Step Functions — the full error detail still lives there.
  processingError   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  audioRecording AudioRecording?
  transcript     Transcript?
  clinicalNotes  ClinicalNote[]
  auditLogs      AuditLog[]

  @@index([patientId])
  @@index([clinicianId])
  @@map("encounters")
}

model AudioRecording {
  id          String    @id @default(uuid())
  encounterId String    @unique
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  s3Key       String
  durationSec Int?
  uploadedAt  DateTime  @default(now())
  // Set once the raw audio object is purged from S3 (on note sign-off, or by
  // the bucket's backstop lifecycle rule) — the row itself is kept as an
  // auditable record that a recording existed and when it was removed.
  deletedAt   DateTime?

  @@map("audio_recordings")
}

model Transcript {
  id               String    @id @default(uuid())
  encounterId      String    @unique
  encounter        Encounter @relation(fields: [encounterId], references: [id])
  rawText          String
  diarizedSegments Json?
  sttProvider      String    @default("aws-transcribe-medical")
  createdAt        DateTime  @default(now())

  @@map("transcripts")
}

model ClinicalNote {
  id                 String     @id @default(uuid())
  encounterId        String
  encounter          Encounter  @relation(fields: [encounterId], references: [id])
  version            Int        @default(1)
  subjective         String?
  objective          String?
  assessment         String?
  plan               String?
  suggestedCodes     Json?
  status             NoteStatus @default(DRAFT)
  signedById         String?
  signedBy           User?      @relation("SignedByUser", fields: [signedById], references: [id])
  signedAt           DateTime?
  // Collected once, right after signing — the clinician's own read on this
  // specific draft, feeding the Phase 5 pilot case study alongside the
  // measured review-time/edit-count metrics (see MetricsService).
  satisfactionRating Int?
  feedbackComment    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([encounterId])
  @@map("clinical_notes")
}

model AuditLog {
  id          String     @id @default(uuid())
  // At least one of encounterId/patientId/targetUserId must be set — not
  // DB-enforced (this codebase doesn't use check constraints for invariants
  // like this elsewhere), just a convention every writer must follow.
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  patientId   String?
  patient     Patient?   @relation(fields: [patientId], references: [id])
  targetUserId String?
  targetUser   User?     @relation("AuditLogTargetUser", fields: [targetUserId], references: [id])
  actorId      String
  actor        User      @relation("AuditLogActor", fields: [actorId], references: [id])
  action       String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime  @default(now())

  @@index([encounterId])
  @@index([patientId])
  @@index([targetUserId])
  @@map("audit_logs")
}

// Right-to-request-amendment/deletion under HIPAA (45 CFR 164.526) is a
// request the clinic may deny, not an obligation to act — and Pennsylvania
// retention law (49 Pa. Code § 16.95, longer floor for minors) forbids
// actually deleting/anonymizing records as a side effect of this flow. This
// model is strictly log-and-route-for-review: it never deletes or mutates
// Patient or clinical data itself.
model PatientDataRequest {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])
  // Freeform, following the same no-enum convention as AuditLog.action:
  // 'deletion' | 'amendment'
  requestType String
  reason      String?
  // 'pending' | 'approved' | 'denied'
  status     String @default("pending")
  loggedById String
  loggedBy   User   @relation("PatientDataRequestLoggedBy", fields: [loggedById], references: [id])

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("PatientDataRequestResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_data_requests")
}
